# 在终端 export 这些变量；应用不会自动读取 .env 文件。
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-chat-model
LLM_API_KEY=replace-with-your-key
# 可选，默认项目下的 data/，勿放到公共静态文件目录。
# VOICE_DATA_DIR=/absolute/private/path
# BREEZE_MODEL=mlx-community/Breeze-TTS-2-mlx-4bit
# STT_MODEL=mlx-community/whisper-small-mlx  # 可改为本地 Whisper 模型目录

# 每次任务（聊天 + 合成）的总预算，正的有限秒数；默认 180。
# TASK_TIMEOUT_SECONDS=180

# 本地训练复用 BREEZE_MODEL / STT_MODEL / VOICE_DATA_DIR，无额外远程服务。
# 需安装 ffmpeg、ffprobe；训练参数通过 /api/training/datasets/{id}/jobs JSON 传入。
# 默认 batch=1、rank=4、steps=20、learning_rate=0.0001、accumulation_steps=1。
# data/training 与 data/voice_models 为私人训练文件，勿放入静态目录。
# 仅硬件验收脚本使用；平时不设置，且不加载正式数据：
# RUN_BREEZE_TRAINING_HARDWARE=1
